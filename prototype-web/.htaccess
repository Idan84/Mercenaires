# Blood & Wages — réglages du serveur Hostinger (Apache).
# Les deux en-têtes de sécurité qui étaient dans netlify.toml.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Pages HTML toujours revérifiées : elles portent les numéros de version des scripts et des styles.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
