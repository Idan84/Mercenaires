ion://d4d2e45b-5b8b-4a3f-8437-b17d3219b49a}} data source, you must \"view\" {{collection://d4d2e45b-5b8b-4a3f-8437-b17d3219b49a}} to query this column\n\t\"Peuple\" TEXT, -- JSON array of page URLs relating to {{collection://38a69f94-eb57-4c24-a240-b2f0f66b2ea9}} data source, you must \"view\" {{collection://38a69f94-eb57-4c24-a240-b2f0f66b2ea9}} to query this column\n\t\"Possible\" TEXT, -- \"__YES__\" = true, \"__NO__\" = false, NULL defaults to false\n\t\"Poids relatif\" FLOAT,\n\t\"Association\" TEXT\n)\n</sqlite-table>\n</data-source>\n</data-sources>\nHere are the Database's Views:\nYou can use the \"fetch\" tool on the URL of any View to see its full configuration.\n<views>\n<view url=\"{{view://22dcaa60-eae7-4d69-8564-79e2711f2ca1}}\">\n{\"dataSourceUrl\":\"{{collection://0c570ca2-205c-4612-8a3e-e99eb80bc889}}\",\"displayProperties\":[\"Association\",\"Ascendance\",\"Peuple\",\"Poids relatif\",\"Possible\"],\"name\":\"Default view\",\"type\":\"table\"}\n</view>\n</views>\n</database>"
